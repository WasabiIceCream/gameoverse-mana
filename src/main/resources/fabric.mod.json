{
  "schemaVersion": 1,
  "id": "gameoverse_mana",
  "version": "${version}",
  "name": "Gameoverse Mana",
  "description": "Spells that cost runes are paid with mana (Mana Attributes) when you have enough, with the rune as a fallback. Max mana grows with spell power, and Dynamic Resource Bars shows the mana bar.",
  "authors": ["WasabiIceCream"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["net.gameoverse.mana.GameoverseMana"],
    "client": ["net.gameoverse.mana.client.GameoverseManaClient"]
  },
  "mixins": ["gameoverse_mana.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": ">=26.1",
    "java": ">=25",
    "manaattributes": "*",
    "spell_engine": "*",
    "spell_power": "*"
  },
  "suggests": {
    "dynamic_resource_bars": "*"
  }
}
